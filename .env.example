# ─── Database ────────────────────────────────────────────────────
# SQLite works out of the box on Render with a persistent disk.
# For Render Postgres, replace with your internal DB URL:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./medcare_pharma.db

# ─── Ollama Cloud ────────────────────────────────────────────────
# The Ollama cloud API uses the exact same wire format as local Ollama
# but runs on Ollama's hosted infrastructure — no GPU needed on your end.
#
# Cloud host (do NOT change unless Ollama updates their API domain)
OLLAMA_HOST=https://ollama.com
# Model — must be available in the Ollama library (https://ollama.com/library)
OLLAMA_MODEL=llama3.2
# API key — generate one at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here

# ─── API Base URL ────────────────────────────────────────────────
# Set to your Render public URL after first deploy, e.g.:
#   API_BASE_URL=https://medcare-ai.onrender.com
API_BASE_URL=http://localhost:8000
