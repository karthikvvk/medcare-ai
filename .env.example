# Database configuration
# SQLite fallback is used automatically if DATABASE_URL is empty or mysql is not configured.
DATABASE_URL=sqlite:///./medcare_pharma.db

# Optional MySQL configuration
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secretpassword
# MYSQL_DATABASE=medcare_pharma

# Optional LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=

# API URL for Dashboard communication
API_BASE_URL=http://localhost:8000

# Ollama configuration (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
